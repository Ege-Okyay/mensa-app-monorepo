{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mensa-today-cron",
    "main": "src/index.ts",
    "compatibility_date": "2026-07-31",
    "triggers": {
        "crons": [
            "0,20,40 9 * * *",
            "0,20 10 * * *",
            "30,50 15 * * *",
            "10 16 * * *",
            "0 13 * * *"
        ]
    },
    "vars": {
        "GITHUB_OWNER": "Ege-Okyay",
        "GITHUB_REPO": "mensa-app-monorepo",
        "GITHUB_REF": "main",
        "GITHUB_API_BASE": "https://api.github.com",
        "DRY_RUN": false
    }
}